    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use esta tool para verificar se um horário específico está disponível \nem uma data. Se o horário solicitado não estiver disponível, sugira \nos horários mais próximos disponíveis acima e abaixo do solicitado.\nPasse a data no formato YYYY-MM-DD.\nNunca confirme horários que já passaram — sempre compare com o horário atual de Brasília antes de criar o agendamento.",
        "operation": "executeQuery",
        "query": "WITH horarios AS (\n  SELECT generate_series(\n    ($1::date + TIME '09:00')::timestamptz AT TIME ZONE 'America/Sao_Paulo',\n    ($1::date + TIME '18:00')::timestamptz AT TIME ZONE 'America/Sao_Paulo',\n    INTERVAL '15 minutes'\n  ) AS horario\n),\nocupados AS (\n  SELECT data_hora FROM agendamentos\n  WHERE DATE(data_hora AT TIME ZONE 'America/Sao_Paulo') = $1::date\n  AND status = 'confirmado'\n)\nSELECT TO_CHAR(horario AT TIME ZONE 'America/Sao_Paulo', 'HH24:MI') AS horario_livre\nFROM horarios\nWHERE horario NOT IN (SELECT data_hora FROM ocupados)\nORDER BY horario",
        "options": {
          "queryReplacement": "={{ $fromAI(\"data\", \"data para verificar horários no formato YYYY-MM-DD\") }}"
        }
      },

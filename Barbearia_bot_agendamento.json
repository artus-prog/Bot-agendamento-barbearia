    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use esta tool para consultar a data e hora atual de Brasília.\nUse SEMPRE antes de criar ou verificar qualquer agendamento para garantir que a data e horário estão corretos.",
        "outputFieldName": "data_hora_atual",

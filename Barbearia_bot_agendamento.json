    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = input?.body?.data || input?.data || input;\n\nif (!data?.key?.remoteJid || data.key.remoteJid.includes('@g.us')) {\n  return [];\n}\nif (data.key.fromMe === true) {\n  return [];\n}\n\nconst telefone = data.key.remoteJid.replace('@s.whatsapp.net', '');\nconst nome = data.pushName || 'Cliente';\nconst mensagemTexto = data.message?.conversation \n  || data.message?.extendedTextMessage?.text \n  || '';\nconst audioUrl = data.message?.audioMessage?.url || null;\nconst messageId = data.key?.id || null;\nconst isAudio = !!audioUrl;\n\nif (!mensagemTexto && !isAudio) return [];\n\nreturn [{\n  json: { telefone, nome, mensagem: mensagemTexto, isAudio, audioUrl, messageId }\n}];"
      },

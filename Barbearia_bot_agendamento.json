      "name": "data_hora_atual"
    },
    {
      "parameters": {
        "jsCode": "const dataHora = $input.first().json.data_hora;\nconst dt = new Date(dataHora);\n\n// Converte UTC para Brasília subtraindo 3 horas\nconst brasilia = new Date(dt.getTime() - 3 * 60 * 60 * 1000);\n\nconst pad = n => String(n).padStart(2, '0');\nconst ano = brasilia.getUTCFullYear();\nconst mes = pad(brasilia.getUTCMonth() + 1);\nconst dia = pad(brasilia.getUTCDate());\nconst hora = pad(brasilia.getUTCHours());\nconst min = pad(brasilia.getUTCMinutes());\n\nconst inicio = `${ano}-${mes}-${dia}T${hora}:${min}:00-03:00`;\nconst fim = new Date(brasilia.getTime() + 60 * 60 * 1000);\nconst fimStr = `${fim.getUTCFullYear()}-${pad(fim.getUTCMonth()+1)}-${pad(fim.getUTCDate())}T${pad(fim.getUTCHours())}:${pad(fim.getUTCMinutes())}:00-03:00`;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    data_inicio: inicio,\n    data_fim: fimStr\n  }\n}];"
      },
